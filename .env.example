# Backend
DATABASE_URL=postgresql://smartroute:smartroute_dev@localhost:5432/smartroute?schema=public
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Clerk (filled in Plan 2)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Flight provider — "mock" (default) or "duffel"
# Sign up at https://app.duffel.com/access/sign-up and paste a duffel_test_* key
FLIGHT_PROVIDER=mock
DUFFEL_API_KEY=
DUFFEL_BASE_URL=https://api.duffel.com

# Walking distances for Itinerary generation — "mock" (default) or "osrm".
# "mock" derives deterministic straight-line-plus-detour times and needs no
# service, which is what keeps tests and CI offline. "osrm" uses the self-hosted
# foot profile (ADR-0005) for real pedestrian routes; build its extract with
# apps/backend/scripts/osrm/prepare-extract.sh, then
# `docker compose --profile osrm up -d osrm`.
WALKING_PROVIDER=mock
OSRM_BASE_URL=http://localhost:5050
